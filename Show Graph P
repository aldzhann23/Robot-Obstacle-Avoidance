import numpy as np
import matplotlib.pyplot as plt

setpoint = 15.0
t = np.linspace(0, 5, 800)

def damped_response(t, A, tau, w):
    return setpoint + A * np.exp(-t / tau) * np.sin(w * t)

# P: overshoot besar + osilasi kuat
y_P = damped_response(t, A=7.5, tau=1.2, w=3.8)

plt.figure(figsize=(8, 5))
plt.plot(t, y_P, label="P")
plt.axhline(setpoint, linestyle="--", label=f"Setpoint {setpoint:.0f} cm")
plt.title("Respons Step - P Saja")
plt.xlabel("Waktu (detik)")
plt.ylabel("Jarak (cm)")
plt.grid(True, alpha=0.35)
plt.legend()
plt.tight_layout()
plt.savefig("grafik_P_saja.png", dpi=200)
plt.show()
